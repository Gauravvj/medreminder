# ── MongoDB ─────────────────────────────────────────
# Connection string for MongoDB (local or Atlas)
# For local: mongodb://localhost:27017/medreminder
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medreminder
MONGO_URI=mongodb://localhost:27017/medreminder

# ── JWT ─────────────────────────────────────────────
# Secret key for signing JWT tokens (change this to a strong random string)
JWT_SECRET=change_me_to_a_random_secret

# ── Google Gemini AI ────────────────────────────────
# API key for Google Gemini (used by the MedBot chatbot)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server ──────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173
